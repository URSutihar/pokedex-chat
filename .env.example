# ---------------------------------------------------------------------------
# The server's own API key. Used for the model and for web search.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...

# ---------------------------------------------------------------------------
# Password that unlocks the key above.
#
#   set it     → visitors type it in the browser to spend your key
#   leave it   → the key is LOCKED: the server refuses to spend it and visitors
#                must bring their own. That is deliberate — forgetting to set a
#                password should not silently hand your key to whoever finds the
#                port.
#
# Accepts plain text, or an scrypt hash. Set or change it with:
#   python scripts/set_password.py --random
# The change takes effect on the very next request — no restart.
# ---------------------------------------------------------------------------
APP_PASSWORD=

# Escape hatch for a solo machine: no password, key spent for anyone who reaches
# the port. Only sane bound to 127.0.0.1. Also live — revoking needs no restart.
# ALLOW_OPEN=true

# Optional second provider for the main model. Web search always uses OpenRouter.
GROQ_API_KEY=

# --- optional overrides ----------------------------------------------------
# PROVIDER=openrouter                # openrouter | groq
# MODEL=deepseek/deepseek-v3.2       # pins the default; else auto-picked
# SEARCH_MODEL=openai/gpt-5-mini
# PUBLIC_URL=http://localhost:8000   # attribution shown on OpenRouter
# PORT=8000

# --- cost ceilings ---------------------------------------------------------
# DAILY_USD_CEILING=5.0              # server-key spend per UTC day
# PER_REQUEST_USD_CEILING=0.75
# MAX_OUTPUT_TOKENS=4000
# MAX_TOOL_ROUNDS=14
# CHAT_RATE_PER_MIN=12
# CHAT_BURST=6

# --- ops -------------------------------------------------------------------
# LOG_FORMAT=json                    # json | text
# LOG_LEVEL=INFO
# TRUST_PROXY=false                  # honour X-Forwarded-For behind a proxy
# CORS_ORIGINS=                      # comma-separated; empty = same-origin only
